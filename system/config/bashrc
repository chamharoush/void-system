# .bashrc

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias ll='ls -l --color=auto'

# Global Aliases

alias vi='vim'
alias copy='xclip -selection clipboard'

# XBPS

alias i='doas xbps-install -S'
alias u='i; doas xbps-install -u xbps; doas xbps-install -u'
alias q='doas xbps-query -Rs'
alias r='doas xbps-remove -R'

parse_git_branch() {
    local branch=$(git branch --show-current 2> /dev/null)
    if [ -n "$branch" ]; then
        echo " ($branch)"
    fi
}

# Tokyo Night Storm prompt colors

tn_blue='\[\033[1;38;2;122;162;247m\]'     # #7aa2f7
tn_red='\[\033[1;38;2;247;118;142m\]'      # #f7768e
tn_purple='\[\033[38;2;187;154;247m\]'     # #bb9af7
tn_orange='\[\033[38;2;255;158;100m\]'     # #ff9e64
tn_reset='\[\033[0m\]'

dbx_prefix=""
if [ -n "$CONTAINER_ID" ]; then
    dbx_prefix="${tn_green}⬢ (distrobox): ${CONTAINER_ID}${tn_reset} "
fi

if [ "$EUID" -eq 0 ]; then
    PS1="${dbx_prefix}${tn_red}\W${tn_reset}${tn_purple}\$(parse_git_branch)${tn_reset} ${tn_orange}>${tn_reset} "
else
    PS1="${dbx_prefix}${tn_blue}\W${tn_reset}${tn_purple}\$(parse_git_branch)${tn_reset} ${tn_orange}>${tn_reset} "
fi

export PATH="$HOME/src/bin:$HOME/.local/bin:$PATH"
export DOCKER_BUILDKIT=1


# Added by Antigravity CLI installer
export PATH="/home/bkaztaou/.local/bin:$PATH"
